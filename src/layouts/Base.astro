---
import '@fontsource-variable/inter';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import Spark from '../components/Spark.astro';
import Dock from '../components/Dock.astro';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'profile' | 'exam' | 'try';
}
const {
  title,
  description = 'A phone practice desk for Advanced Web Page Design. The same point, said again, until the labels stick.',
  current,
} = Astro.props;
const full = title ? `${title} · Again` : 'Again';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/"><Spark /> Again</a>
        <a class="colours-link" href="/colours">Colours</a>
      </header>
      <slot />
    </div>
    <Dock current={current} />
  </body>
</html>
