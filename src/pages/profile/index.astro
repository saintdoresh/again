---
import Base from '../../layouts/Base.astro';
import { profileSteps } from '../../data/profile';
---
<Base title="The profile" current="profile">
  <h1>The personal profile</h1>
  <p class="lede">The brief asks for a header, a menu, an about section, three skill boxes, a contact section, and a footer. The paint goes in a separate file. You learn the labels first, then each band of the page.</p>
  <p><a class="pill" href="/profile/tag">Start with a tag</a></p>
  <p class="caption">The finished example is a real HTML file, the kind you will submit. <a href="/study/profile/index.html">Open it</a>.</p>
  <ol class="lessons">
    {profileSteps.map((step) => (
      <li>
        <a data-slug={step.slug} href={`/profile/${step.slug}`}>
          <strong>{step.title}</strong>
          <span>{step.summary}</span>
        </a>
      </li>
    ))}
  </ol>
</Base>
<script>
  const seen = JSON.parse(localStorage.getItem('again-seen-profile') || '[]') as string[];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-slug]')];
  links.forEach((link, index) => {
    const slug = link.dataset.slug || '';
    if (seen.includes(slug)) link.classList.add('seen');
    if (index === 0) return;
    const earlier = links[index - 1].dataset.slug || '';
    const stage = localStorage.getItem(`again-stage-profile-${earlier}`);
    const old = localStorage.getItem(`again-lock-profile-${earlier}`);
    if (stage === 'done' || old === 'done') return;
    link.classList.add('is-locked');
    link.removeAttribute('href');
    link.setAttribute('aria-disabled', 'true');
  });
</script>
