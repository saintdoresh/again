---
import Base from '../../layouts/Base.astro';
import { examSteps } from '../../data/exam';
---
<Base title="The exam" current="exam">
  <h1>The exam paper</h1>
  <p class="lede">A five-page site for Contact Marketing Services Ltd. The pages are linked. The paint is one separate file. Do the profile first if the labels are still new.</p>
  <p><a class="pill" href="/exam/pages">Start with the five pages</a></p>
  <ol class="lessons">
    {examSteps.map((step) => (
      <li>
        <a data-slug={step.slug} href={`/exam/${step.slug}`}>
          <strong>{step.title}</strong>
          <span>{step.summary}</span>
        </a>
      </li>
    ))}
  </ol>
  <p class="caption">The finished example is plain HTML, in its own folder. <a href="/study/cmsl/index.html">Open the site</a> and use the menu.</p>
</Base>
<script>
  const seen = JSON.parse(localStorage.getItem('again-seen-exam') || '[]') as string[];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-slug]')];
  links.forEach((link, index) => {
    const slug = link.dataset.slug || '';
    if (seen.includes(slug)) link.classList.add('seen');
    if (index === 0) return;
    const earlier = links[index - 1].dataset.slug || '';
    const stage = localStorage.getItem(`again-stage-exam-${earlier}`);
    const old = localStorage.getItem(`again-lock-exam-${earlier}`);
    if (stage === 'done' || old === 'done') return;
    link.classList.add('is-locked');
    link.removeAttribute('href');
    link.setAttribute('aria-disabled', 'true');
  });
</script>
