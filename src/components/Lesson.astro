---
import Again from './Again.astro';
import Drill from './Drill.astro';
import Preview from './Preview.astro';
import { drills } from '../data/drills';
import { firstMiss } from '../scripts/drill';
import type { Step } from '../data/types';

interface Link { href: string; title: string }
interface Props {
  step: Step;
  index: number;
  total: number;
  trail: { href: string; label: string };
  prev: Link | null;
  next: Link | null;
}
const { step, index, total, trail, prev, next } = Astro.props;
const track = trail.href.includes('/exam') ? 'exam' : 'profile';
const drill = drills[`${track}:${step.slug}`];
const lockKey = `again-lock-${track}-${step.slug}`;
const hintKey = `again-hints-${track}-${step.slug}`;
const gap = drill ? firstMiss(drill.practice.rules, drill.practice.starter) : null;
const hints = gap ? [gap.miss.remember, gap.miss.do] : [];
---
<script is:inline define:vars={{ lockKey, hintKey }}>
  try {
    if (localStorage.getItem(lockKey) === 'open') document.documentElement.classList.add('is-assessing');
    if (localStorage.getItem(hintKey) === '2') document.documentElement.classList.add('is-code-open');
  } catch (error) {}
</script>
<div class="backrow">
  <a class="back" href={trail.href}>{trail.label}</a>
  <p class="where">{index + 1} of {total}</p>
</div>
<h1>{step.title}</h1>
<div class="lesson">
{step.brief && (
  <figure class="brief">
    <blockquote>{step.brief}</blockquote>
    <figcaption>{step.briefFrom}</figcaption>
  </figure>
)}

<h2>Look here</h2>
<Preview preview={step.preview} />
{step.preview.kind === 'page' && step.preview.src.includes('#') && (
  <p class="caption">The clay outline is the part this lesson is about.</p>
)}

<div class="after-look">
  <Again tellings={step.tellings} />
</div>

{(step.html || step.css) && hints.length === 2 && (
  <div class="code-lock" data-hints={hintKey}>
    <h2>The correct code</h2>
    <div data-hint-list></div>
    <p class="hint" data-hint-status>Closed. Two hints, then it opens.</p>
    <button type="button" class="pill" data-hint>Hint</button>
  </div>
)}
<div class="answers">
{step.html && (
  <>
    <h2>The labels</h2>
    <pre class="code"><code>{step.html.trim()}</code></pre>
  </>
)}
{step.css && (
  <>
    <h2>The paint</h2>
    <pre class="code"><code>{step.css.trim()}</code></pre>
  </>
)}
</div>

<h2>Line by line</h2>
<ol class="says">
  {step.lines.map((line) => (
    <li>
      <code>{line.code}</code>
      <span>{line.says}</span>
    </li>
  ))}
</ol>

{step.friend && (
  <div class="friend">
    <h2>A friend wrote this</h2>
    <p>This is not your file, and it is not the version to copy. It is here so you can see the difference after the right labels.</p>
    <pre class="code"><code>{step.friend.code.trim()}</code></pre>
    <p>{step.friend.why}</p>
  </div>
)}

{step.slug === 'colours' && (
  <p><a href="/colours">See every colour, and the job it does.</a></p>
)}
{step.slug === 'marker' && (
  <p><a href="/try">Type your own page on this phone.</a></p>
)}
</div>

{drill && <Drill drill={drill} id={`${track}-${step.slug}`} lockKey={lockKey} />}

<nav class="turn" aria-label="Lessons">
  {prev ? <a class="prev" href={prev.href}>{prev.title}</a> : <span></span>}
  {next && <a class="next" href={next.href}>{next.title}</a>}
</nav>

<script define:vars={{ hintKey, hints }}>
  const lock = document.querySelector('[data-hints]');
  const button = lock?.querySelector('[data-hint]');
  const list = lock?.querySelector('[data-hint-list]');
  const status = lock?.querySelector('[data-hint-status]');
  if (lock && button instanceof HTMLButtonElement && list && status && Array.isArray(hints)) {
    let count = Number(localStorage.getItem(hintKey) || '0');
    if (!Number.isFinite(count) || count < 0) count = 0;

    const paint = () => {
      list.replaceChildren();
      for (let index = 0; index < Math.min(count, 2); index += 1) {
        const row = document.createElement('p');
        const label = document.createElement('strong');
        label.textContent = `Hint ${index + 1}.`;
        row.append(label, document.createTextNode(` ${hints[index]}`));
        list.append(row);
      }
      if (count >= 2) {
        localStorage.setItem(hintKey, '2');
        document.documentElement.classList.add('is-code-open');
        status.textContent = 'The correct code is open.';
        return;
      }
      status.textContent = count === 0
        ? 'Closed. Two hints, then the correct code opens.'
        : 'One hint left. Then the correct code opens.';
      button.textContent = count === 0 ? 'Hint' : 'Second hint';
    };

    button.addEventListener('click', () => {
      count += 1;
      localStorage.setItem(hintKey, String(count));
      paint();
    });
    paint();
  }
</script>
<script define:vars={{ slug: step.slug, trail: trail.href }}>
  const key = trail.includes('/exam') ? 'again-seen-exam' : 'again-seen-profile';
  const seen = JSON.parse(localStorage.getItem(key) || '[]');
  if (!seen.includes(slug)) {
    seen.push(slug);
    localStorage.setItem(key, JSON.stringify(seen));
  }
</script>
