---
import Base from '../../layouts/Base.astro';
import Lesson from '../../components/Lesson.astro';
import { profileSteps } from '../../data/profile';
import type { Step } from '../../data/types';

export function getStaticPaths() {
  return profileSteps.map((step, index) => ({
    params: { slug: step.slug },
    props: {
      step,
      index,
      total: profileSteps.length,
      prev: index > 0 ? { href: `/profile/${profileSteps[index - 1].slug}`, title: profileSteps[index - 1].title } : null,
      next: index < profileSteps.length - 1 ? { href: `/profile/${profileSteps[index + 1].slug}`, title: profileSteps[index + 1].title } : null,
    },
  }));
}

interface Props {
  step: Step;
  index: number;
  total: number;
  prev: { href: string; title: string } | null;
  next: { href: string; title: string } | null;
}
const { step, index, total, prev, next } = Astro.props;
---
<Base title={step.title} current="profile">
  <Lesson
    step={step}
    index={index}
    total={total}
    prev={prev}
    next={next}
    trail={{ href: '/profile', label: 'The profile' }}
  />
</Base>
